# ============================================
# 🌍 HOPE TURTLE ENVIRONMENT CONFIGURATION
# ============================================

# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Database
DB_HOST=localhost
DB_USER=silabumi
DB_PASS=mayLove&LightFlow_human2human_across|borders
DB_NAME=hopeturtle_db

# Security
JWT_SECRET=changeme
SESSION_SECRET=changeme

# Integrations
BUWANA_API_URL=https://buwana.ecobricks.org
MAPBOX_TOKEN=your_mapbox_token_here

# Ecojoiner generator (Python + reportlab)
# Run `npm run ecojoiner:setup` once to create ecojoiner/.venv, which is used
# automatically. Set ECOJOINER_PYTHON to point at a different interpreter.
# ECOJOINER_PYTHON=/usr/bin/python3
ECOJOINER_JOB_TTL_DAYS=7
ECOJOINER_TIMEOUT_MS=30000

# Appearance
DEFAULT_THEME=light
SUPPORTED_THEMES=light,dark

# Languages
DEFAULT_LANG=en
SUPPORTED_LANGS=en,ms,id,he,ar,de,zh,tr,fr,es

# Sustainability
INCLUDE_WEBSITE_CARBON=true


# ===========================
# 🌐 Buwana Authentication
# ===========================

# The HopeTurtles registered client details
BUWANA_CLIENT_ID=hope_8fc3caabded4
BUWANA_CLIENT_SECRET=replace_with_secure_secret   # <-- DO NOT COMMIT YOUR REAL ONE
BUWANA_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----

-----END PUBLIC KEY-----"

# The Buwana API base URL
BUWANA_API_URL=https://buwana.ecobricks.org

# Buwana OIDC endpoints
BUWANA_AUTHORIZE_URL=https://buwana.ecobricks.org/authorize.php
BUWANA_TOKEN_URL=https://buwana.ecobricks.org/token.php
BUWANA_JWKS_URI=https://buwana.ecobricks.org/.well-known/jwks.php
BUWANA_REDIRECT_URI=https://hopeturtles.org/auth/callback

# Namespaced Buwana scopes (all granted to HopeTurtles)
# buwana:basic      → buwana_id, email, given_name, earthlingEmoji
# buwana:profile    → family_name, role, profile_pic, community_id, zoneinfo, birth_date, …
# buwana:community  → community name
# buwana:bioregion  → location, watershed, lat/long
# buwana:profile.read / .write → read + update the profile via the Buwana API (required for the profile page)
BUWANA_SCOPE=openid buwana:basic buwana:profile buwana:community buwana:bioregion buwana:profile.read buwana:profile.write

# JWT configuration
JWT_ALGO=RS256
JWT_EXPIRY=12h
