<% const githubRepo = 'https://github.com/h2h-project/turtleOS'; %>
<% const turtleShellRepo = 'https://github.com/h2h-project/turtle_Shells'; %>
<% const installCommand = 'bash <(curl -fsSL https://raw.githubusercontent.com/h2h-project/turtleOS/main/scripts/install_turtleOS.sh)'; %>
<% const syncCommand = 'bash <(curl -fsSL https://raw.githubusercontent.com/h2h-project/turtleOS/main/scripts/sync_turtleOS.sh)'; %>
<%- include('partials/header', { pageTitle, theme, lang, direction }) %>
<%- include('partials/nav') %>
<main id="main" class="turtleos-page">
  <section class="page-banner">
    <img class="page-banner__bg" src="/images/help-code.webp" alt="" aria-hidden="true" />
    <div class="page-banner__inner">
      <div class="page-banner__heading">
        <h1 class="page-banner__title"><%= t.turtleos_title %></h1>
        <p class="page-banner__lead">
          <%= t.turtleos_lead %>
        </p>
      </div>
      <div class="page-banner__actions">
        <a class="button" href="<%= githubRepo %>" target="_blank" rel="noopener noreferrer">
          <i class="fa-brands fa-github" aria-hidden="true"></i> <%= t.turtleos_view_code %>
        </a>
        <a class="button" href="<%= turtleShellRepo %>" target="_blank" rel="noopener noreferrer">
          <i class="fa-brands fa-github" aria-hidden="true"></i> <%= t.turtleos_view_pcb %>
        </a>
      </div>
    </div>
  </section>

  <div class="layout">
    <section class="page-split">
      <div class="page-split__main">
        <p class="turtleos-lead">
          <%= t.turtleos_body_p1 %>
        </p>

        <p>
          <%= t.turtleos_body_p2 %>
        </p>

        <p>
          <%= t.turtleos_body_p3 %>
        </p>

        <p>
          <%= t.turtleos_body_p4 %>
        </p>

        <p>
          <%= t.turtleos_body_p5 %>
        </p>

        <p>
          <%- t.turtleos_body_p6 %>
        </p>

        <p>
          <%= t.turtleos_body_p7 %>
        </p>

        <p>
          <%= t.turtleos_body_p8 %>
        </p>

        <p>
          <%= t.turtleos_body_p9 %>
        </p>

        <h2><%= t.turtleos_get_going_title %></h2>

        <p>
          <%= t.turtleos_get_going_body %>
        </p>

        <div class="turtleos-actions">
          <a class="button" href="<%= githubRepo %>" target="_blank" rel="noopener noreferrer">
            <i class="fa-brands fa-github" aria-hidden="true"></i> <%= t.turtleos_open_repo %>
          </a>
        </div>
      </div>

      <aside class="page-split__aside">
        <div class="turtleos-pcb-card">
          <figure class="turtleos-figure">
            <img src="/images/circuit-dev.webp" alt="<%= t.turtleos_circuit_alt %>" loading="lazy" />
            <figcaption><%= t.turtleos_circuit_caption %></figcaption>
          </figure>

          <p class="code-copy__caption"><%= t.turtleos_install_caption %></p>
          <div class="code-copy" data-code-copy>
            <code class="code-copy__text"><%= installCommand %></code>
            <button type="button" class="code-copy__button" data-copy-target aria-label="<%= t.turtleos_copy_install_aria %>">
              <i class="fa-regular fa-copy" aria-hidden="true"></i>
              <span class="code-copy__label"><%= t.turtleos_copy_label %></span>
            </button>
          </div>

          <p class="code-copy__caption"><%= t.turtleos_sync_caption %></p>
          <div class="code-copy" data-code-copy>
            <code class="code-copy__text"><%= syncCommand %></code>
            <button type="button" class="code-copy__button" data-copy-target aria-label="<%= t.turtleos_copy_sync_aria %>">
              <i class="fa-regular fa-copy" aria-hidden="true"></i>
              <span class="code-copy__label"><%= t.turtleos_copy_label %></span>
            </button>
          </div>
        </div>

        <div class="turtleos-pcb-card">
          <img class="turtleos-pcb-card__image" src="/images/shell-v1.webp" alt="<%= t.turtleos_pcb_alt %>" loading="lazy" />
          <h2 class="turtleos-pcb-card__title"><%= t.turtleos_pcb_title %></h2>
          <p class="turtleos-pcb-card__body"><%= t.turtleos_pcb_body %></p>
          <a class="button" href="<%= turtleShellRepo %>" target="_blank" rel="noopener noreferrer">
            <i class="fa-brands fa-github" aria-hidden="true"></i> <%= t.turtleos_pcb_button %>
          </a>
          <p class="turtleos-pcb-card__caption"><%= t.turtleos_pcb_button_caption %></p>
        </div>
      </aside>
    </section>
  </div>
</main>
<script>
  (function () {
    var copiedLabel = <%- JSON.stringify(t.turtleos_copied) %>;
    document.querySelectorAll('[data-code-copy]').forEach(function (box) {
      const button = box.querySelector('[data-copy-target]');
      const text = box.querySelector('.code-copy__text');
      const label = button && button.querySelector('.code-copy__label');
      if (!button || !text) return;
      button.addEventListener('click', function () {
        const value = text.textContent.trim();
        const done = function () {
          if (!label) return;
          const original = label.textContent;
          label.textContent = copiedLabel;
          window.setTimeout(function () {
            label.textContent = original;
          }, 1800);
        };
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(value).then(done).catch(function () {});
        } else {
          const range = document.createRange();
          range.selectNodeContents(text);
          const selection = window.getSelection();
          selection.removeAllRanges();
          selection.addRange(range);
          try {
            document.execCommand('copy');
            done();
          } catch (error) {
            /* no-op */
          }
          selection.removeAllRanges();
        }
      });
    });
  })();
</script>
<%- include('partials/footer') %>
