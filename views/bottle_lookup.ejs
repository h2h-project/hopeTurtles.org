<%- include('partials/header', { pageTitle, theme, bodyClass }) %>
<%- include('partials/nav') %>
<main id="main" class="layout generate-page bottle-lookup-page" data-bottle-lookup-page>
  <div class="bottle-lookup-hero" data-bottle-lookup-hero>
    <div class="generate-intro">
      <h1>Bottle Lookup</h1>
      <p>
        Search for a Hope Turtle aid bottle by its serial number to see its journey status.
      </p>
    </div>
    <form class="bottle-lookup-form" data-bottle-lookup-form>
      <label class="sr-only" for="bottleLookupInput">Bottle serial number</label>
      <input
        type="search"
        id="bottleLookupInput"
        name="serial"
        placeholder="Enter a bottle serial number…"
        autocomplete="off"
        minlength="2"
        required
        data-bottle-lookup-input
      />
      <button type="submit" class="button" data-bottle-lookup-submit>
        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
        Search
      </button>
    </form>
    <p class="form-feedback" role="status" aria-live="polite" data-bottle-lookup-feedback hidden></p>
  </div>

  <section class="bottle-lookup-results" data-bottle-lookup-results hidden>
    <h2>Matching bottles</h2>
    <ul class="turtle-bottles-list" data-bottle-lookup-list></ul>
    <p class="panel-empty" data-bottle-lookup-empty hidden>
      No bottles found with that serial number.
    </p>
  </section>
</main>

<dialog id="bottleLookupModal" class="mission-dialog" aria-labelledby="bottleLookupModalTitle">
  <article class="form-card">
    <header class="mission-dialog__header">
      <div>
        <h2 id="bottleLookupModalTitle" data-bottle-lookup-modal-serial>Bottle</h2>
        <p class="panel-subtitle" data-bottle-lookup-modal-status></p>
      </div>
      <button
        type="button"
        class="dialog-close"
        data-close-bottle-lookup-modal
        aria-label="Close"
      >
        &times;
      </button>
    </header>
    <div class="turtle-bottle-card__photo bottle-lookup-modal-photo" data-bottle-lookup-modal-photo hidden>
      <img data-bottle-lookup-modal-photo-img alt="" />
    </div>
    <dl class="bottle-lookup-modal-details" data-bottle-lookup-modal-details></dl>
  </article>
</dialog>

<% const pageScripts = ['/js/bottle-lookup.js']; %>
<%- include('partials/footer', { pageScripts }) %>
