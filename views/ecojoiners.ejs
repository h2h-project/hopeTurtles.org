<% const bambooGallery = [
  { src: '/images/ecojoiners/assembly-777px.webp', alt: t.eco_alt_assembly },
  { src: '/images/ecojoiners/cube-777px.webp', alt: t.eco_alt_cube },
  { src: '/images/ecojoiners/ecojoiners-and-briks-777px.webp', alt: t.eco_alt_briks },
  { src: '/images/ecojoiners/cube-table-777px.webp', alt: t.eco_alt_cube_table },
  { src: '/images/ecojoiners/coffee-table-777px.webp', alt: t.eco_alt_coffee_table },
  { src: '/images/ecojoiners/singapore-festival-777px.webp', alt: t.eco_alt_singapore }
]; %>
<%- include('partials/header', { pageTitle, theme, lang, direction }) %>
<%- include('partials/nav') %>
<main id="main" class="ecojoiners-page">
  <section class="page-banner">
    <img class="page-banner__bg" src="/images/ecojoiner-background.webp" alt="" aria-hidden="true" />
    <div class="page-banner__inner">
      <div class="page-banner__heading">
        <h1 class="page-banner__title"><%= t.eco_banner_title %></h1>
        <p class="page-banner__lead"><%= t.eco_banner_lead %></p>
      </div>
      <div class="page-banner__actions">
        <a class="button" href="/ecojoiners/generate">
          <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i> <%= t.eco_banner_cta %>
        </a>
      </div>
    </div>
  </section>

  <div class="layout">
    <section class="page-split">
      <div class="page-split__main">
        <%# These paragraphs carry inline links and emphasis, so they render unescaped. %>
        <p><%- t.eco_intro_p1 %></p>
        <p><%- t.eco_intro_p2 %></p>
        <p><%- t.eco_intro_p3 %></p>
        <p><%- t.eco_intro_p4 %></p>
        <p><%- t.eco_intro_p5 %></p>
        <p><%- t.eco_intro_p6 %></p>

        <aside class="ecojoiners-note">
          <h2><%= t.eco_note_title %></h2>
          <p><%= t.eco_note_body %></p>
        </aside>

        <h2><%= t.eco_build_title %></h2>
        <p><%= t.eco_build_body %></p>
        <div class="ecojoiners-actions">
          <a class="button" href="/ecojoiners/generate">
            <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i> <%= t.eco_build_cta %>
          </a>
        </div>

        <section class="eco-gallery-section">
          <h2><%= t.eco_gallery_title %></h2>
          <div class="eco-gallery">
            <% bambooGallery.forEach(function (image) { %>
              <figure class="eco-gallery__item">
                <img src="<%= image.src %>" alt="<%= image.alt %>" loading="lazy" />
              </figure>
            <% }) %>
          </div>
        </section>
      </div>

      <aside class="page-split__aside">
        <figure class="ecojoiners-figure">
          <img src="/images/wood-ecojoiner.webp" alt="<%= t.eco_alt_wood %>" loading="lazy" />
        </figure>
        <figure class="ecojoiners-figure">
          <img src="/images/ecojoiners/making.webp" alt="<%= t.eco_alt_help %>" loading="lazy" />
        </figure>
        <figure class="ecojoiners-figure">
          <img src="/images/ecojoiners/cut_em.webp" alt="<%= t.eco_alt_cut %>" loading="lazy" />
        </figure>
      </aside>
    </section>
  </div>
</main>
<%- include('partials/footer') %>
