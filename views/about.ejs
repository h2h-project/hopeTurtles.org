<% const pageScripts = [
  'https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js',
  '/js/about.js'
]; %>
<%- include('partials/header', { pageTitle, theme, lang, direction }) %>
<%- include('partials/nav') %>
<% const metrics = aboutMetrics || {}; %>
<main id="main" class="about-page">
  <section class="page-banner">
    <img class="page-banner__bg" src="/images/about-background.webp" alt="" aria-hidden="true" />
    <div class="page-banner__inner">
      <div class="page-banner__heading">
        <h1 class="page-banner__title"><%= t.about_heading || 'About the Hope Turtle Project' %></h1>
        <p class="page-banner__lead"><%= t.about_subheading || '- A human to human intention' %></p>
      </div>
      <div class="page-banner__actions">
        <a class="button" href="/Hope_Turtle_Whitepaper--June_2026.pdf" target="_blank" rel="noopener noreferrer">
          <i class="fa-solid fa-file-pdf" aria-hidden="true"></i> <%= t.about_read_whitepaper %>
        </a>
      </div>
    </div>
  </section>

  <div class="layout">
    <section class="page-split">
      <div class="page-split__main">
        <p><%= t.about_body_p1 %></p>

        <p><%= t.about_body_p2 %></p>

        <!-- <p><%= t.about_body_p3 %></p> -->

        <p><%= t.about_body_p4 %></p>

        <h2><%= t.about_principles_title %></h2>
        <ul class="about-principles-list">
          <li><strong><%= t.about_principle_earth_label %>:</strong> <%= t.about_principle_earth_body %></li>
          <li><strong><%= t.about_principle_love_label %>:</strong> <%= t.about_principle_love_body %></li>
          <li><strong><%= t.about_principle_opensource_label %>:</strong> <%= t.about_principle_opensource_body %></li>
          <li><strong><%= t.about_principle_locable_label %>:</strong> <%= t.about_principle_locable_body %></li>
          <li><strong><%= t.about_principle_noncapital_label %>:</strong> <%= t.about_principle_noncapital_body %></li>
          <li><strong><%= t.about_principle_spiral_label %>:</strong> <%= t.about_principle_spiral_body %></li>
        </ul>

        <p><%= t.about_body_p5 %></p>

        <h2><%= t.about_consequences_title %></h2>
        <ol class="about-consequences-list">
          <li><strong><%= t.about_consequence_reusable_label %>:</strong> <%= t.about_consequence_reusable_body %></li>
          <li><strong><%= t.about_consequence_biodegradable_label %>:</strong> <%= t.about_consequence_biodegradable_body %></li>
          <li><strong><%= t.about_consequence_fixable_label %>:</strong> <%= t.about_consequence_fixable_body %></li>
          <li><strong><%= t.about_consequence_replicable_label %>:</strong> <%= t.about_consequence_replicable_body %></li>
          <li><strong><%= t.about_consequence_lowcost_label %>:</strong> <%= t.about_consequence_lowcost_body %></li>
        </ol>
      </div>

      <aside class="page-split__aside">
        <div class="about-materials-card">
          <h2><%= t.about_materials_title %></h2>
          <canvas id="about-materials-chart" role="img" aria-label="<%= t.about_materials_title %>"></canvas>
        </div>
        <% const materialsBreakdown = [
          { key: 'food', pct: 83, label: t.about_material_food, examples: t.about_material_food_examples },
          { key: 'wood', pct: 9, label: t.about_material_wood, examples: t.about_material_wood_examples },
          { key: 'metal', pct: 2, label: t.about_material_metal, examples: t.about_material_metal_examples },
          { key: 'lithium', pct: 3, label: t.about_material_lithium, examples: t.about_material_lithium_examples },
          { key: 'plastic', pct: 2, label: t.about_material_plastic, examples: t.about_material_plastic_examples },
          { key: 'misc', pct: 1, label: t.about_material_misc, examples: t.about_material_misc_examples }
        ]; %>
        <%# `<` is escaped so a string containing markup cannot close this tag early. %>
        <script id="about-materials-data" type="application/json"><%- JSON.stringify(materialsBreakdown).replace(/</g, '\\u003c') %></script>
        <figure class="about-figure">
          <img src="/images/turtle-floating.webp" alt="A Hope Turtle floating on the open sea" loading="lazy" />
          <figcaption><%= t.about_caption_prototype || 'A prototype turtle at sea' %></figcaption>
        </figure>
        <figure class="about-figure">
          <img src="/images/uk_testing.webp" alt="<%= t.about_alt_uk_testing %>" loading="lazy" />
        </figure>
        <a
          class="button ghost"
          href="https://github.com/h2h-project/turtleOS"
          target="_blank"
          rel="noopener noreferrer"
        >
          <i class="fa-brands fa-github" aria-hidden="true"></i>
          <%= t.about_cta_github || 'View the project on GitHub' %>
        </a>
      </aside>
    </section>

    <div class="about-whitepaper-cta">
      <a class="button" href="/Hope_Turtle_Whitepaper--June_2026.pdf" target="_blank" rel="noopener noreferrer">
        <i class="fa-solid fa-file-pdf" aria-hidden="true"></i>
        <%= t.about_read_whitepaper || 'Read the White Paper' %>
      </a>
    </div>

    <% if (false) { /* metrics hidden for now */ %>
    <section class="about-metrics-section">
      <div class="about-metrics" aria-label="Hope Turtle platform metrics">
        <article class="metric-card about-metric">
          <span class="metric-label"><%= t.metric_turtles || 'Turtles' %></span>
          <span class="metric-value"><%= Number(metrics.turtles || 0).toLocaleString() %></span>
        </article>
        <article class="metric-card about-metric">
          <span class="metric-label"><%= t.about_metric_users || 'Users' %></span>
          <span class="metric-value"><%= Number(metrics.users || 0).toLocaleString() %></span>
        </article>
        <article class="metric-card about-metric">
          <span class="metric-label"><%= t.about_metric_boats || 'Boats' %></span>
          <span class="metric-value"><%= Number(metrics.boats || 0).toLocaleString() %></span>
        </article>
        <article class="metric-card about-metric">
          <span class="metric-label"><%= t.about_metric_hubs || 'Hubs' %></span>
          <span class="metric-value"><%= Number(metrics.hubs || 0).toLocaleString() %></span>
        </article>
      </div>
    </section>
    <% } %>
  </div>
</main>
<%- include('partials/footer', { pageScripts }) %>
