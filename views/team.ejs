<%- include('partials/header', { pageTitle }) %>
<%- include('partials/nav') %>
<main id="main" class="layout team-page">
  <section class="page-header team-page__intro">
    <h1><%= t.team_title || 'Meet the hopeTurtles.org Team' %></h1>
    <p>
      <%=
        t.team_intro ||
          'The Human2Human project is what happens when a scattered crew of self-declared "ninja turtles" — dreamers and doers from nearly every corner of the planet — decide to stop waiting for someone else to fix things. We\'re united by one simple, stubborn intention: to carry real assistance, real love, and real hope to people living through the hardest chapters on Earth, while treading as lightly as we can on the fish, reefs, and creatures who called these waters home long before our little solar-powered turtles showed up. Our core crew is a happily mismatched bunch — technologists debugging code between calls, longtime activists who\'ve never stopped marching, meticulous clerks keeping every ecobrick and every dollar accounted for, and students squeezing mission planning between exams. None of us share a job title, exactly, but we all share the same hunch: that pouring our time and energy into the Hope Turtle vision might just be one of the best, most joyful ways to spend a life on this blue-green planet.'
      %>
    </p>
  </section>

  <% if (!teamMembers.length) { %>
    <p class="empty-state"><%= t.team_empty || 'Our roster is still forming. Check back soon for new crew updates.' %></p>
  <% } else { %>
    <section class="team-grid" aria-live="polite">
      <% teamMembers.forEach(function(member) { %>
        <article class="team-card">
          <div class="team-card__portrait" aria-hidden="<%= member.photoUrl ? 'false' : 'true' %>">
            <% if (member.photoUrl) { %>
              <img src="<%= member.photoUrl %>" alt="Portrait of <%= member.fullName %>" loading="lazy" />
            <% } else { %>
              <span class="team-card__portrait-placeholder" aria-hidden="true"><%= member.emoji %></span>
            <% } %>
          </div>
          <% if (!member.photoUrl) { %>
            <span class="sr-only">No uploaded portrait for <%= member.fullName %></span>
          <% } %>
          <div class="team-card__details">
            <h2 class="team-card__name"><%= member.fullName %></h2>
            <p class="team-card__title">
              <span class="team-card__title-emoji" aria-hidden="true"><%= member.emoji %></span>
              <span><%= member.title %></span>
            </p>
            <% if (member.profileText) { %>
              <p class="team-card__bio"><%= member.profileText %></p>
            <% } %>
            <p class="team-card__meta-line"><%= t.team_continent || 'Continent' %> · <strong><%= member.continent %></strong></p>
            <p class="team-card__meta-line"><%= t.team_watershed || 'Watershed' %> · <strong><%= member.watershed %></strong></p>
          </div>
        </article>
      <% }) %>
    </section>
  <% } %>
</main>
<%- include('partials/footer') %>
