<%- include('partials/header', { pageTitle, theme, bodyClass }) %>
<%- include('partials/nav') %>
<main id="main" class="layout generate-page lookup-page" data-lookup-page>
  <div class="lookup-hero" data-lookup-hero>
    <div class="generate-intro">
      <h1>Lookup</h1>
      <p>
        Search for a Hope Turtle aid bottle or a turtle itself to see its journey status.
      </p>
    </div>

    <div class="lookup-tabs" role="tablist" aria-label="Lookup type">
      <button
        type="button"
        class="lookup-tab is-active"
        role="tab"
        id="lookupTabBottles"
        aria-selected="true"
        aria-controls="lookupPanelBottles"
        data-lookup-tab="bottles"
      >
        <i class="fa-solid fa-bottle-water" aria-hidden="true"></i> Bottles
      </button>
      <button
        type="button"
        class="lookup-tab"
        role="tab"
        id="lookupTabTurtles"
        aria-selected="false"
        aria-controls="lookupPanelTurtles"
        data-lookup-tab="turtles"
        tabindex="-1"
      >
        <i class="fa-solid fa-shield-halved" aria-hidden="true"></i> Turtles
      </button>
    </div>

    <div
      class="lookup-panel"
      id="lookupPanelBottles"
      role="tabpanel"
      aria-labelledby="lookupTabBottles"
      data-lookup-panel="bottles"
    >
      <form class="lookup-form" data-lookup-form="bottles">
        <label class="sr-only" for="lookupBottleInput">Bottle serial number</label>
        <input
          type="search"
          id="lookupBottleInput"
          name="serial"
          placeholder="Enter a bottle serial number…"
          autocomplete="off"
          minlength="2"
          required
          data-lookup-input="bottles"
        />
        <button type="submit" class="button" data-lookup-submit="bottles">
          <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
          Search
        </button>
      </form>
    </div>

    <div
      class="lookup-panel"
      id="lookupPanelTurtles"
      role="tabpanel"
      aria-labelledby="lookupTabTurtles"
      data-lookup-panel="turtles"
      hidden
    >
      <form class="lookup-form" data-lookup-form="turtles">
        <label class="sr-only" for="lookupTurtleInput">Turtle serial number or name</label>
        <input
          type="search"
          id="lookupTurtleInput"
          name="q"
          placeholder="Enter a turtle serial number or name…"
          autocomplete="off"
          minlength="2"
          required
          data-lookup-input="turtles"
        />
        <button type="submit" class="button" data-lookup-submit="turtles">
          <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
          Search
        </button>
      </form>
    </div>

    <p class="form-feedback" role="status" aria-live="polite" data-lookup-feedback hidden></p>
  </div>

  <section class="lookup-results" data-lookup-results hidden>
    <h2 data-lookup-results-title>Matching bottles</h2>
    <ul class="turtle-bottles-list" data-lookup-list></ul>
    <p class="panel-empty" data-lookup-empty hidden>
      No results found.
    </p>
  </section>
</main>

<dialog id="bottleLookupModal" class="mission-dialog" aria-labelledby="bottleLookupModalTitle">
  <article class="form-card">
    <header class="mission-dialog__header">
      <div>
        <h2 id="bottleLookupModalTitle" data-bottle-lookup-modal-serial>Bottle</h2>
        <p class="panel-subtitle" data-bottle-lookup-modal-status></p>
      </div>
      <button
        type="button"
        class="dialog-close"
        data-close-bottle-lookup-modal
        aria-label="Close"
      >
        &times;
      </button>
    </header>
    <div class="turtle-bottle-card__photo bottle-lookup-modal-photo" data-bottle-lookup-modal-photo hidden>
      <img data-bottle-lookup-modal-photo-img alt="" />
    </div>
    <dl class="bottle-lookup-modal-details" data-bottle-lookup-modal-details></dl>
  </article>
</dialog>

<dialog id="turtleLookupModal" class="mission-dialog" aria-labelledby="turtleLookupModalTitle">
  <article class="form-card">
    <header class="mission-dialog__header">
      <div>
        <h2 id="turtleLookupModalTitle" data-turtle-lookup-modal-name>Turtle</h2>
        <p class="panel-subtitle" data-turtle-lookup-modal-status></p>
      </div>
      <button
        type="button"
        class="dialog-close"
        data-close-turtle-lookup-modal
        aria-label="Close"
      >
        &times;
      </button>
    </header>
    <div class="turtle-bottle-card__photo bottle-lookup-modal-photo" data-turtle-lookup-modal-photo hidden>
      <img data-turtle-lookup-modal-photo-img alt="" />
    </div>
    <dl class="bottle-lookup-modal-details" data-turtle-lookup-modal-details></dl>
  </article>
</dialog>

<% const pageScripts = ['/js/lookup.js']; %>
<%- include('partials/footer', { pageScripts }) %>
