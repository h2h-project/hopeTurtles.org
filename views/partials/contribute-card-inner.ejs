<% if (card.image) { %><div class="contribute-card__image-wrap"><img src="<%= card.image %>" alt="" class="contribute-card__image" loading="lazy" /><span class="contribute-card__title contribute-card__title--overlay"><%= card.title %></span></div><% } else if (card.icon) { %><div class="contribute-card__icon-wrap"><i class="fa-solid <%= card.icon %> contribute-card__icon" aria-hidden="true"></i></div><% } %>
<div class="contribute-card__body">
  <% if (!card.image) { %><span class="contribute-card__title"><%= card.title %></span><% } %>
  <span class="contribute-card__subtitle"><% if (card.subtitleIcon) { %><i class="fa-solid <%= card.subtitleIcon %> contribute-card__subtitle-icon" aria-hidden="true"></i><% } %><span class="contribute-card__subtitle-text"><%= card.subtitle %></span></span>
</div>
