<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= direction %>" data-theme="<%= theme %>">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="<%= typeof metaDescription !== 'undefined' ? metaDescription : 'HopeTurtles.org – regenerative humanitarian tracking platform for autonomous hope turtles delivering aid across ocean currents.' %>"
    />
    <meta property="og:title" content="<%= typeof pageTitle !== 'undefined' ? pageTitle : 'HopeTurtles.org' %>" />
    <meta
      property="og:description"
      content="<%= typeof metaDescription !== 'undefined' ? metaDescription : 'Tracking autonomous Hope Turtles as they ferry regenerative aid across the ocean.' %>"
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://hopeturtles.org" />
    <meta property="og:image" content="<%= typeof ogImage !== 'undefined' ? ogImage : '/images/social-card.svg' %>" />
    <title><%= pageTitle %></title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Aleo:wght@400;700&family=Mulish:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/main.css" />
    <% if (typeof extraStyles !== 'undefined') { %>
      <% extraStyles.forEach(function (styleHref) { %>
        <link rel="stylesheet" href="<%= styleHref %>" />
      <% }); %>
    <% } %>
    <script src="https://kit.fontawesome.com/735e38ff98.js" crossorigin="anonymous"></script>
    <script>
      // Pre-paint color mode (Buwana color-mode contract, key `color_mode`).
      // Order: saved choice from the server (theme cookie / Buwana ?mode=)
      // → localStorage → legacy keys → prefers-color-scheme → server default.
      (function () {
        const root = document.documentElement;
        const ok = (m) => m === 'light' || m === 'dark';
        const serverTheme = '<%= theme %>';
        const serverExplicit = <%= (typeof themeExplicit !== 'undefined' && themeExplicit) ? 'true' : 'false' %>;
        let theme = null;
        let source = 'default';
        let stored = null;
        try {
          stored = localStorage.getItem('color_mode') ||
            localStorage.getItem('ht-theme') ||
            localStorage.getItem('hopeturtles-theme');
        } catch (e) {}
        if (serverExplicit && ok(serverTheme)) {
          theme = serverTheme;
          source = 'server';
        } else if (ok(stored)) {
          theme = stored;
          source = 'storage';
        } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
          theme = 'dark';
          source = 'system';
        } else {
          theme = ok(serverTheme) ? serverTheme : 'light';
        }
        root.dataset.theme = theme;
        root.dataset.themeSource = source;
        if (source === 'server' || source === 'storage') {
          try { localStorage.setItem('color_mode', theme); } catch (e) {}
        }
        try {
          const storedLang = localStorage.getItem('ht-lang');
          if (storedLang) root.lang = storedLang;
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="app-shell<%= typeof bodyClass !== 'undefined' && bodyClass ? ' ' + bodyClass : '' %>">
    <a class="skip-link" href="#main"><%= t.skip_to_content %></a>
