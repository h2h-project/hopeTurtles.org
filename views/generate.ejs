<%- include('partials/header', { pageTitle, theme, lang, direction, metaDescription, ogImage, bodyClass }) %>
<%- include('partials/nav') %>
<% if (!currentUser) { %>
<main id="main" class="generate-login">
  <div class="generate-login__content">
    <div class="generate-login__inner">
      <span class="generate-login__eyebrow">🐢 <%= t.gen_login_required_eyebrow || 'HopeTurtles' %></span>
      <h1><%= t.gen_login_required_title %></h1>
      <p><%= t.gen_login_required_body %></p>
      <div class="generate-login__actions">
        <a class="button" href="<%= loginUrl %>">
          <i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i>
          <%= t.gen_login_required_cta %>
        </a>
        <a
          class="button ghost"
          href="https://buwana.ecobricks.org/en/signup-1.php?app=hope_8fc3caabded4"
          target="_blank"
          rel="noreferrer"
        >
          <i class="fa-solid fa-user-plus" aria-hidden="true"></i>
          <%= t.nav_signup || 'Signup' %>
        </a>
      </div>
    </div>
  </div>
  <div class="generate-login__media">
    <img src="/images/ecojoiners/select-material.webp" alt="" loading="lazy" />
  </div>
</main>
<% } else { %>
<main id="main" class="layout generate-page">
  <div class="eco-dev-notice eco-dev-notice--top" role="status">
    <i class="fa-solid fa-flask" aria-hidden="true"></i>
    <span>
      <strong><%= t.gen_notice_title %></strong>
      <%= t.gen_notice_body %>
    </span>
  </div>

  <div class="generate-intro">
    <h1><%= t.gen_hero_title %></h1>
    <p><%= t.gen_hero_blurb %></p>
  </div>

  <div class="eco-fields eco-profile-picker-row">
    <label class="eco-field">
      <span class="eco-field__label">Load a saved ecojoiner design</span>
      <select id="eco-design-picker" data-eco-design-picker>
        <option value="">Start a new design</option>
      </select>
    </label>
    <label class="eco-field">
      <span class="eco-field__label">Load a saved bottle profile</span>
      <select id="eco-profile-picker" data-eco-profile-picker>
        <option value="">Start a new profile</option>
      </select>
    </label>
    <label class="eco-field">
      <span class="eco-field__label">PDF language</span>
      <% const pdfLangDefault = ['tr', 'id'].includes(lang) ? lang : 'en'; %>
      <select id="eco-pdf-lang" name="pdfLang">
        <option value="en" <%= pdfLangDefault === 'en' ? 'selected' : '' %>>English</option>
        <option value="tr" <%= pdfLangDefault === 'tr' ? 'selected' : '' %>>Türkçe</option>
        <option value="id" <%= pdfLangDefault === 'id' ? 'selected' : '' %>>Bahasa Indonesia</option>
      </select>
    </label>
  </div>

  <form class="eco-generate" id="eco-generate" novalidate>
    <div class="eco-panels">

      <!-- Panel 1 — Select your bottle -->
      <details class="eco-panel" data-panel="bottle" open>
        <summary class="eco-panel__head">
          <span class="eco-panel__step">1</span>
          <span class="eco-panel__heading">
            <span class="eco-panel__title"><%= t.gen_p1_title %></span>
            <span class="eco-panel__desc"><%= t.gen_p1_desc %></span>
          </span>
          <i class="fa-solid fa-chevron-down eco-panel__chevron" aria-hidden="true"></i>
        </summary>
        <div class="eco-panel__body">
          <div class="eco-panel__content">
            <div class="eco-panel__text">
              <p><%= t.gen_p1_body %></p>
              <div class="eco-fields">
                <label class="eco-field">
                  <span class="eco-field__label"><%= t.gen_field_brand %></span>
                  <input type="text" id="eco-brand" name="brand" placeholder="<%= t.gen_field_brand_ph %>" autocomplete="off" />
                  <span class="eco-feedback" data-for="eco-brand"></span>
                </label>
                <label class="eco-field">
                  <span class="eco-field__label"><%= t.gen_field_volume %> <span class="eco-field__unit"><%= t.gen_unit_ml %></span></span>
                  <input type="number" id="eco-volume" name="volume" inputmode="numeric" min="0" step="10" placeholder="<%= t.gen_field_volume_ph %>" />
                  <span class="eco-feedback" data-for="eco-volume"></span>
                </label>
                <label class="eco-field eco-field--full">
                  <span class="eco-field__label">Photo of your bottle</span>
                  <div class="eco-photo-field">
                    <div class="eco-photo-preview" data-eco-bottle-photo-preview hidden>
                      <img data-eco-bottle-photo-preview-img alt="Current bottle photo" />
                    </div>
                    <input type="file" id="eco-bottle-photo" name="bottlePhoto" accept="image/*" />
                  </div>
                </label>
              </div>
            </div>
            <figure class="eco-panel__figure">
              <img src="/images/ecojoiners/chose_bottle.webp" alt="<%= t.gen_p1_alt %>" loading="lazy" />
            </figure>
          </div>
        </div>
      </details>

      <!-- Panel 2 — Set your bottle specs -->
      <details class="eco-panel" data-panel="specs">
        <summary class="eco-panel__head">
          <span class="eco-panel__step">2</span>
          <span class="eco-panel__heading">
            <span class="eco-panel__title"><%= t.gen_p2_title %></span>
            <span class="eco-panel__desc"><%= t.gen_p2_desc %></span>
          </span>
          <i class="fa-solid fa-chevron-down eco-panel__chevron" aria-hidden="true"></i>
        </summary>
        <div class="eco-panel__body">
          <div class="eco-panel__content">
            <div class="eco-panel__text">
              <%# Carries <strong> emphasis on the unit, so it renders unescaped. %>
              <p><%- t.gen_p2_body %></p>
              <div class="eco-fields eco-fields--grid">
                <label class="eco-field">
                  <span class="eco-field__label"><%= t.gen_field_diameter %></span>
                  <input type="number" id="eco-diameter" name="diameter" inputmode="numeric" min="0" step="1" placeholder="<%= t.gen_field_diameter_ph %>" />
                  <span class="eco-feedback" data-for="eco-diameter"></span>
                </label>
                <label class="eco-field">
                  <span class="eco-field__label"><%= t.gen_field_cap %></span>
                  <input type="number" id="eco-cap" name="cap" inputmode="numeric" min="0" step="1" placeholder="<%= t.gen_field_cap_ph %>" />
                  <span class="eco-feedback" data-for="eco-cap"></span>
                </label>
                <label class="eco-field">
                  <span class="eco-field__label"><%= t.gen_field_collar %></span>
                  <input type="number" id="eco-collar" name="collar" inputmode="numeric" min="0" step="1" placeholder="<%= t.gen_field_collar_ph %>" />
                  <span class="eco-feedback" data-for="eco-collar"></span>
                </label>
                <label class="eco-field">
                  <span class="eco-field__label"><%= t.gen_field_height %></span>
                  <input type="number" id="eco-height" name="height" inputmode="numeric" min="0" step="1" placeholder="<%= t.gen_field_height_ph %>" />
                  <span class="eco-feedback" data-for="eco-height"></span>
                </label>
                <label class="eco-field">
                  <span class="eco-field__label"><%= t.gen_field_top_tapper %></span>
                  <input type="number" id="eco-top-tapper" name="topTapper" inputmode="numeric" min="0" step="1" placeholder="<%= t.gen_field_top_tapper_ph %>" />
                  <span class="eco-feedback" data-for="eco-top-tapper"></span>
                </label>
                <label class="eco-field">
                  <span class="eco-field__label"><%= t.gen_field_bottom_tapper %></span>
                  <input type="number" id="eco-bottom-tapper" name="bottomTapper" inputmode="numeric" min="0" step="1" placeholder="<%= t.gen_field_bottom_tapper_ph %>" />
                  <span class="eco-feedback" data-for="eco-bottom-tapper"></span>
                </label>
              </div>
            </div>
            <figure class="eco-panel__figure">
              <img src="/images/ecojoiners/bottle_keys.webp" alt="<%= t.gen_p2_alt %>" loading="lazy" />
            </figure>
          </div>
          <div class="eco-panel__footer eco-panel__footer--end" data-eco-save-profile-footer hidden>
            <span class="eco-feedback" data-eco-save-profile-feedback></span>
            <button type="button" class="button ghost" id="eco-save-profile-btn">
              <i class="fa-regular fa-floppy-disk" aria-hidden="true"></i> <%= t.gen_save_profile_btn %>
            </button>
          </div>
          <div class="eco-panel__footer eco-panel__footer--end" data-eco-save-profile-changes-footer hidden>
            <span class="eco-feedback" data-eco-save-profile-changes-feedback></span>
            <button type="button" class="button ghost" id="eco-save-profile-changes-btn">
              <i class="fa-regular fa-floppy-disk" aria-hidden="true"></i> Save Bottle Changes
            </button>
          </div>
        </div>
      </details>

      <!-- Panel 3 — Set your material specs -->
      <details class="eco-panel" data-panel="material">
        <summary class="eco-panel__head">
          <span class="eco-panel__step">3</span>
          <span class="eco-panel__heading">
            <span class="eco-panel__title"><%= t.gen_p3_title %></span>
            <span class="eco-panel__desc"><%= t.gen_p3_desc %></span>
          </span>
          <i class="fa-solid fa-chevron-down eco-panel__chevron" aria-hidden="true"></i>
        </summary>
        <div class="eco-panel__body">
          <div class="eco-panel__content">
            <div class="eco-panel__text">
              <p><%= t.gen_p3_body %></p>
              <div class="eco-fields">
                <label class="eco-field">
                  <span class="eco-field__label"><%= t.gen_field_material %></span>
                  <select id="eco-material" name="material">
                    <option value=""><%= t.gen_material_choose %></option>
                    <option value="solid-wood"><%= t.gen_material_solid %></option>
                    <option value="pallet-wood"><%= t.gen_material_pallet %></option>
                    <option value="plywood"><%= t.gen_material_plywood %></option>
                    <option value="particle-board"><%= t.gen_material_particle %></option>
                    <option value="plastic"><%= t.gen_material_plastic %></option>
                    <option value="other"><%= t.gen_material_other %></option>
                  </select>
                  <span class="eco-feedback" data-for="eco-material"></span>
                </label>
                <label class="eco-field">
                  <span class="eco-field__label"><%= t.gen_field_thickness %> <span class="eco-field__unit"><%= t.gen_unit_mm %></span></span>
                  <input type="number" id="eco-thickness" name="thickness" inputmode="decimal" min="0" step="0.1" placeholder="<%= t.gen_field_thickness_ph %>" />
                  <span class="eco-feedback" data-for="eco-thickness"></span>
                </label>
              </div>
            </div>
            <figure class="eco-panel__figure">
              <img src="/images/ecojoiners/select-material.webp" alt="<%= t.gen_p3_alt %>" loading="lazy" />
            </figure>
          </div>
        </div>
      </details>

      <!-- Panel 4 — Select ecojoiner type -->
      <details class="eco-panel" data-panel="type">
        <summary class="eco-panel__head">
          <span class="eco-panel__step">4</span>
          <span class="eco-panel__heading">
            <span class="eco-panel__title"><%= t.gen_p5_title %></span>
            <span class="eco-panel__desc"><%= t.gen_p5_desc %></span>
          </span>
          <i class="fa-solid fa-chevron-down eco-panel__chevron" aria-hidden="true"></i>
        </summary>
        <div class="eco-panel__body">
          <div class="eco-panel__content eco-panel__content--single">
            <div class="eco-panel__text">
              <p><%= t.gen_p5_body %></p>
              <% const devTypes = [
                { type: '3fc', label: t.gen_type_3fc },
                { type: '4fc', label: t.gen_type_4fc },
                { type: '2fc', label: t.gen_type_2fc },
                { type: 'fin', label: t.gen_type_fin },
                { type: 'ballast', label: t.gen_type_ballast }
              ]; %>
              <div class="eco-type-grid" role="radiogroup" aria-label="<%= t.gen_type_group %>">
                <button type="button" class="eco-type-card" data-type="6fc" data-available="true" role="radio" aria-checked="false">
                  <span class="eco-type-card__thumb">
                    <img src="/images/ecojoiners/just-ecojoiner.webp" alt="<%= t.gen_type_6fc %>" loading="lazy" />
                  </span>
                  <span class="eco-type-card__title"><%= t.gen_type_6fc %></span>
                </button>
                <% devTypes.forEach(function (option) { %>
                  <button type="button" class="eco-type-card eco-type-card--dev" data-type="<%= option.type %>" data-available="false">
                    <span class="eco-type-card__thumb">
                      <img src="/images/ecojoiners/ecojoiner-under-dev.webp" alt="<%= option.label %> — <%= t.gen_type_dev_suffix %>" loading="lazy" />
                    </span>
                    <span class="eco-type-card__title"><%= option.label %></span>
                  </button>
                <% }) %>
              </div>
              <input type="hidden" id="eco-type" name="ecojoinerType" value="" />
              <span class="eco-feedback" data-for="eco-type"></span>
            </div>
          </div>
        </div>
      </details>

      <!-- Panel 5 — Adjust connection -->
      <details class="eco-panel" data-panel="connection">
        <summary class="eco-panel__head">
          <span class="eco-panel__step">5</span>
          <span class="eco-panel__heading">
            <span class="eco-panel__title"><%= t.gen_p6_title %></span>
            <span class="eco-panel__desc"><%= t.gen_p6_desc %></span>
          </span>
          <i class="fa-solid fa-chevron-down eco-panel__chevron" aria-hidden="true"></i>
        </summary>
        <div class="eco-panel__body">
          <div class="eco-panel__content eco-panel__content--single">
            <div class="eco-panel__text">
              <p><%= t.gen_p6_body %></p>
              <div class="eco-connection-slider">
                <div class="eco-connection-slider__value" data-eco-connection-value><%= t.gen_connection_exact %></div>
                <input
                  type="range"
                  id="eco-connection"
                  min="0"
                  max="4"
                  step="1"
                  value="1"
                  data-eco-connection
                  aria-label="<%= t.gen_p6_title %>"
                />
                <input type="hidden" id="eco-connection-mm" name="portFitMm" value="0" />
                <div class="eco-connection-slider__ticks">
                  <span><%= t.gen_connection_loose %></span>
                  <span><%= t.gen_connection_exact %></span>
                  <span><%= t.gen_connection_snug %></span>
                  <span><%= t.gen_connection_tight %></span>
                  <span><%= t.gen_connection_supertight %></span>
                </div>
              </div>
              <span class="eco-feedback" data-for="eco-connection"></span>
            </div>
          </div>
        </div>
      </details>

      <!-- Panel 6 — Select fabrication -->
      <details class="eco-panel" data-panel="fabrication">
        <summary class="eco-panel__head">
          <span class="eco-panel__step">6</span>
          <span class="eco-panel__heading">
            <span class="eco-panel__title"><%= t.gen_p4_title %></span>
            <span class="eco-panel__desc"><%= t.gen_p4_desc %></span>
          </span>
          <i class="fa-solid fa-chevron-down eco-panel__chevron" aria-hidden="true"></i>
        </summary>
        <div class="eco-panel__body">
          <div class="eco-panel__content eco-panel__content--single">
            <div class="eco-panel__text">
              <p><%= t.gen_p4_body %></p>
              <ul class="eco-fab-list">
                <li class="eco-fab-option">
                  <span class="eco-fab-option__info">
                    <span class="eco-fab-option__title"><%= t.gen_fab_carpentry %></span>
                    <span class="eco-fab-option__desc"><%= t.gen_fab_carpentry_desc %></span>
                  </span>
                  <label class="ht-toggle">
                    <input type="checkbox" id="eco-fab-carpentry" name="fabCarpentry" />
                    <span class="ht-toggle__slider" aria-hidden="true"></span>
                  </label>
                </li>
                <li class="eco-fab-option">
                  <span class="eco-fab-option__info">
                    <span class="eco-fab-option__title"><%= t.gen_fab_3d %></span>
                    <span class="eco-fab-option__desc"><%= t.gen_fab_3d_desc %></span>
                  </span>
                  <label class="ht-toggle">
                    <input type="checkbox" id="eco-fab-3d" name="fab3d" />
                    <span class="ht-toggle__slider" aria-hidden="true"></span>
                  </label>
                </li>
                <li class="eco-fab-option">
                  <span class="eco-fab-option__info">
                    <span class="eco-fab-option__title"><%= t.gen_fab_cnc %></span>
                    <span class="eco-fab-option__desc"><%= t.gen_fab_cnc_desc %></span>
                  </span>
                  <label class="ht-toggle">
                    <input type="checkbox" id="eco-fab-dxf" name="fabDxf" />
                    <span class="ht-toggle__slider" aria-hidden="true"></span>
                  </label>
                </li>
                <li class="eco-fab-option">
                  <span class="eco-fab-option__info">
                    <span class="eco-fab-option__title"><%= t.gen_fab_vector %></span>
                    <span class="eco-fab-option__desc"><%= t.gen_fab_vector_desc %></span>
                  </span>
                  <label class="ht-toggle">
                    <input type="checkbox" id="eco-fab-svg" name="fabSvg" />
                    <span class="ht-toggle__slider" aria-hidden="true"></span>
                  </label>
                </li>
              </ul>
              <span class="eco-feedback" data-for="eco-fabrication"></span>
            </div>
          </div>
        </div>
      </details>

    </div>

    <div class="eco-actions">
      <button type="button" class="button ghost" id="eco-save">
        <i class="fa-regular fa-floppy-disk" aria-hidden="true"></i> <%= t.gen_save %>
      </button>
      <button type="submit" class="button" id="eco-generate-btn">
        <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i> <%= t.gen_submit %>
      </button>
    </div>

    <!-- Filled in by /js/ecojoiner-generate.js: derived dimensions first, then
         the download links once the user confirms. -->
    <section class="eco-results" id="eco-results" hidden aria-live="polite" tabindex="-1"></section>
  </form>

  <dialog id="ecoSaveDialog" class="mission-dialog" aria-labelledby="ecoSaveDialogTitle">
    <form class="form-card mission-dialog__form" data-eco-save-form enctype="multipart/form-data">
      <header class="mission-dialog__header">
        <div>
          <h2 id="ecoSaveDialogTitle">Save your ecojoiner</h2>
          <p class="panel-subtitle">Save this design to your dashboard.</p>
        </div>
        <button type="button" class="dialog-close" data-close-eco-save aria-label="Close">&times;</button>
      </header>
      <div class="mission-form-grid">
        <label class="full-width">
          Name this design
          <input type="text" name="label" placeholder="e.g. Aqua 1.5L" data-eco-save-label required />
        </label>
        <label class="full-width">
          Photo of your finished ecojoiner
          <div class="eco-photo-field">
            <div class="eco-photo-preview" data-eco-save-photo-preview hidden>
              <img data-eco-save-photo-preview-img alt="Current ecojoiner photo" />
            </div>
            <input type="file" name="ecojoiner_photo" accept="image/*" />
          </div>
        </label>
        <div class="eco-fab-option full-width">
          <span class="eco-fab-option__info">
            <span class="eco-fab-option__title">Make this design public</span>
            <span class="eco-fab-option__desc">Public designs get a shareable link. Private designs are only visible to you.</span>
          </span>
          <label class="ht-toggle">
            <input type="checkbox" data-eco-save-visibility />
            <span class="ht-toggle__slider" aria-hidden="true"></span>
          </label>
        </div>
      </div>
      <div class="mission-dialog__actions">
        <button type="button" class="button ghost" data-close-eco-save>Cancel</button>
        <button type="submit" class="button">Save</button>
      </div>
      <p class="form-feedback" role="status" data-eco-save-feedback hidden></p>
      <p class="form-feedback" role="status" data-eco-save-share hidden></p>
    </form>
    <div class="form-card eco-save-success" data-eco-save-success hidden>
      <i class="fa-solid fa-circle-check eco-save-success__icon" aria-hidden="true"></i>
      <h1 class="eco-save-success__title">Your Ecojoiner Design is Saved</h1>
      <p class="eco-save-success__desc">You can find your saved designs on your dashboard for handy revisiting.</p>
      <p class="form-feedback" role="status" data-eco-save-success-share hidden></p>
      <div class="mission-dialog__actions">
        <button type="button" class="button" data-close-eco-save>Done</button>
      </div>
    </div>
  </dialog>
  <% } %>
</main>
<%# Strings the generator script paints into the page at runtime. %>
<% const generateStrings = {}; %>
<% Object.keys(t).filter((key) => key.startsWith('gen_')).forEach((key) => { generateStrings[key] = t[key]; }); %>
<%# `<` is escaped so a string containing markup cannot close this tag early. %>
<script id="eco-i18n" type="application/json"><%- JSON.stringify(generateStrings).replace(/</g, '\\u003c') %></script>
<% const pageScripts = ['/js/ecojoiner-generate.js']; %>
<%- include('partials/footer', { pageScripts }) %>
