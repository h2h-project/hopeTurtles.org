<%- include('partials/header', { pageTitle, theme }) %>
<%- include('partials/nav') %>
<main id="main" class="layout report-page">
  <section class="page-split report-split">
    <div class="page-split__main">
      <header class="page-header report-header">
        <h1><%= t.report_title %></h1>
        <p><%= t.report_intro %></p>
      </header>

      <div class="report-intro-copy">
        <p><%= t.report_why %></p>
        <p><%= t.report_negative %></p>
      </div>

      <%# Step 1 — confirm the turtle by the red number painted on its body. %>
      <section class="report-step" id="reportStepIdentify" data-report-step="identify">
        <h2><%= t.report_identify_title %></h2>
        <p><%= t.report_identify_body %></p>
        <form id="turtleLookupForm" class="form-card report-lookup" novalidate>
          <label for="turtleNumber"><%= t.report_identify_label %></label>
          <div class="report-lookup__row">
            <input
              id="turtleNumber"
              name="fin_code"
              type="text"
              autocomplete="off"
              autocapitalize="characters"
              autocorrect="off"
              spellcheck="false"
              maxlength="5"
              placeholder="<%= t.report_identify_placeholder %>"
              required
            />
            <button type="submit" class="button"><%= t.report_identify_submit %></button>
          </div>
          <p id="turtleLookupFeedback" class="report-feedback" role="status" aria-live="polite"></p>
        </form>
      </section>

      <%# Step 2 — the report form, shown only once the turtle is confirmed. %>
      <section class="report-step success-form report-form" id="reportStepForm" data-report-step="form" hidden>
        <div class="report-confirmed" aria-live="polite">
          <span class="report-confirmed__badge" id="confirmedTurtleNumber"></span>
          <div>
            <p class="report-confirmed__label"><%= t.report_confirmed_label %></p>
            <p class="report-confirmed__name" id="confirmedTurtleName"></p>
            <p class="report-confirmed__mission" id="confirmedTurtleMission"></p>
          </div>
          <button type="button" class="report-link-button" id="changeTurtleButton"><%= t.report_change_turtle %></button>
        </div>

        <h2><%= t.report_form_title %></h2>
        <form id="successForm" class="form-card" enctype="multipart/form-data">
          <input type="hidden" name="turtle_id" id="reportTurtleId" />
          <label>
            <%= t.success_form_date %>
            <input type="date" name="date_found" id="reportDateFound" />
          </label>

          <div class="report-location">
            <div class="report-location__fields">
              <label>
                <%= t.success_form_lat %>
                <input type="number" step="0.000001" min="-90" max="90" name="location_lat" id="reportLat" />
              </label>
              <label>
                <%= t.success_form_lng %>
                <input type="number" step="0.000001" min="-180" max="180" name="location_lng" id="reportLng" />
              </label>
            </div>
            <button type="button" class="button button--secondary" id="useLocationButton">
              <i class="fa-solid fa-location-crosshairs" aria-hidden="true"></i> <%= t.report_use_location %>
            </button>
            <p id="locationFeedback" class="report-feedback" role="status" aria-live="polite"></p>
          </div>

          <label>
            <%= t.report_form_message %>
            <textarea name="thank_you_message" required></textarea>
          </label>
          <label>
            <%= t.success_form_photo %>
            <input type="file" name="photo" accept="image/*" />
          </label>
          <button type="submit" class="button"><%= t.report_form_submit %></button>
          <p id="successFeedback" class="report-feedback" role="status" aria-live="polite"></p>
        </form>
      </section>

      <%# Step 3 — after the report, ask the finder to wake the turtle's Bluetooth. %>
      <section class="report-step report-bluetooth" id="reportStepBluetooth" data-report-step="bluetooth" hidden tabindex="-1">
        <h2><i class="fa-brands fa-bluetooth-b" aria-hidden="true"></i> <%= t.report_bt_title %></h2>
        <p><%= t.report_bt_intro %></p>
        <ol class="report-bluetooth__steps">
          <li><%= t.report_bt_step1 %></li>
          <li><%= t.report_bt_step2 %></li>
          <li><%= t.report_bt_step3 %></li>
          <li><%= t.report_bt_step4 %></li>
        </ol>
        <p class="report-bluetooth__note"><%= t.report_bt_note %></p>
        <p><%= t.report_bt_thanks %></p>
        <button type="button" class="button button--secondary" id="reportAnotherButton"><%= t.report_another %></button>
      </section>
    </div>

    <aside class="page-split__aside">
      <figure class="report-figure">
        <img src="/images/report.webp" alt="<%= t.report_alt_photo %>" width="936" height="1585" />
      </figure>
    </aside>
  </section>
</main>
<script type="application/json" id="report-i18n"><%- JSON.stringify({
  lookupEmpty: t.report_lookup_empty,
  lookupChecking: t.report_lookup_checking,
  lookupNotFound: t.report_lookup_not_found,
  lookupError: t.report_lookup_error,
  turtleNumber: t.report_turtle_number,
  missionPrefix: t.report_mission_prefix,
  locationUnsupported: t.report_location_unsupported,
  locationLocating: t.report_location_locating,
  locationDone: t.report_location_done,
  locationDenied: t.report_location_denied,
  locationFailed: t.report_location_failed,
  submitUploading: t.report_submit_uploading,
  submitFailed: t.report_submit_failed,
  submitNetwork: t.report_submit_network
}).replace(/</g, '\\u003c') %></script>
<% const pageScripts = ['/js/report.js']; %>
<%- include('partials/footer', { pageScripts }) %>
