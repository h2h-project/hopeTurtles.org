<% const extraStyles = ['https://unpkg.com/leaflet@1.9.4/dist/leaflet.css']; %>
<%- include('partials/header', { pageTitle, theme, extraStyles }) %>
<%- include('partials/nav') %>
<main id="main" class="layout layout--home">
  <section class="hero">
    <div class="hero-image">
      <img
        src="/images/marmaris-hopeturtle.webp"
        alt="<%= t.hero_image_alt || 'Illustration of a Hope Turtle floating in the ocean' %>"
        loading="lazy"
      />
    </div>
    <div class="hero-intro">
      <h1><%- t.landing_welcome_title %></h1>
      <p><%= t.landing_intro_paragraph1 %></p>
      <p><%= t.landing_intro_paragraph2 %></p>
    </div>
  </section>

  <% const contributeCards = [
    { title: t.contribute_code_title || 'Code', subtitle: t.contribute_code_body || 'Help develop our turtle python code on Github', url: 'https://github.com/h2h-project/turtleOS', icon: 'fa-code' },
    { title: t.contribute_build_title || 'Build', subtitle: t.contribute_build_body || 'Assemble the hardware for a Hope Turtle', icon: 'fa-screwdriver-wrench' },
    { title: t.contribute_bottle_title || 'Bottle', subtitle: t.contribute_bottle_body || 'Send in food filled aid bottles to our coordination hubs', icon: 'fa-bottle-water' },
    { title: t.contribute_commission_title || 'Commission', subtitle: t.contribute_commission_body || 'Commission the deployment of a HopeTurtle and become its captain', icon: 'fa-compass' },
    { title: t.contribute_deploy_title || 'Deploy', subtitle: t.contribute_deploy_body || 'Help deploy a hub or boat that can receive and release Hope Turtles', icon: 'fa-ship' },
    { title: t.contribute_buy_title || 'Buy', subtitle: t.contribute_buy_body || 'Purchase food orders for our hubs to fill aid bottles', icon: 'fa-bag-shopping' }
  ]; %>
  <div class="contribute-grid" id="contribute">
    <% contributeCards.forEach(function (card) { %>
      <% if (card.url) { %>
        <a href="<%= card.url %>" target="_blank" rel="noreferrer" class="contribute-card">
          <% if (card.icon) { %><i class="fa-solid <%= card.icon %> contribute-card__icon" aria-hidden="true"></i><% } %>
          <span class="contribute-card__title"><%= card.title %></span>
          <span class="contribute-card__subtitle"><%= card.subtitle %></span>
        </a>
      <% } else { %>
        <button type="button" class="contribute-card" data-contribute-action="<%= card.title %>">
          <% if (card.icon) { %><i class="fa-solid <%= card.icon %> contribute-card__icon" aria-hidden="true"></i><% } %>
          <span class="contribute-card__title"><%= card.title %></span>
          <span class="contribute-card__subtitle"><%= card.subtitle %></span>
        </button>
      <% } %>
    <% }) %>
  </div>

  <section class="landing-metrics">
    <div class="metric-card">
      <span class="metric-value"><%= summary.missions %></span>
      <span class="metric-label"><%= t.metric_missions || 'Missions' %></span>
    </div>
    <div class="metric-card">
      <span class="metric-value"><%= summary.turtles %></span>
      <span class="metric-label"><%= t.metric_turtles || 'Hope Turtles' %></span>
    </div>
    <div class="metric-card">
      <span class="metric-value"><%= summary.successes %></span>
      <span class="metric-label"><%= t.metric_success || 'Successful Landfalls' %></span>
    </div>
  </section>
</main>
<% const pageScripts = [
  'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js',
  '/js/home.js'
]; %>
<%- include('partials/footer', { pageScripts }) %>
