<% const extraStyles = ['https://unpkg.com/leaflet@1.9.4/dist/leaflet.css']; %>
<%- include('partials/header', { pageTitle, theme, extraStyles }) %>
<%- include('partials/nav') %>
<main id="main" class="layout layout--home">
  <section class="hero">
    <div class="hero-image">
      <img
        src="/images/landing-arrival.webp"
        alt="<%= t.hero_image_alt || 'Illustration of a Hope Turtle floating in the ocean' %>"
        loading="lazy"
      />
    </div>
    <div class="hero-intro">
      <h1><%- t.landing_welcome_title %></h1>
      <p><%- t.landing_intro_paragraph1 %></p>
    </div>
  </section>

  <% const contributeCards = [
    { title: t.contribute_code_title || 'Code', subtitle: t.contribute_code_body || 'Help develop our turtle python code on Github', url: 'https://github.com/h2h-project/turtleOS', image: '/images/help-code.webp' },
    { title: t.contribute_build_title || 'Build', subtitle: t.contribute_build_body || 'Assemble the hardware for a Hope Turtle', image: '/images/help-build.webp' },
    { title: t.contribute_bottle_title || 'Bottle', subtitle: t.contribute_bottle_body || 'Send in food filled aid bottles to our coordination hubs', image: '/images/help-food.webp' },
    { title: t.contribute_commission_title || 'Learn', subtitle: t.contribute_commission_body || 'Learn about our Earthen Humanitarian philosophy', icon: 'fa-compass' },
    { title: t.contribute_deploy_title || 'Print', subtitle: t.contribute_deploy_body || 'Print (or help engineer!) our 3D designed components', icon: 'fa-cube' },
    { title: t.contribute_buy_title || 'Contribute', subtitle: t.contribute_buy_body || 'Make a financial contribution to the project', icon: 'fa-hand-holding-heart' }
  ]; %>
  <div class="contribute-grid" id="contribute">
    <% contributeCards.forEach(function (card) { %>
      <% if (card.url) { %>
        <a href="<%= card.url %>" target="_blank" rel="noreferrer" class="contribute-card">
          <% if (card.image) { %><div class="contribute-card__image-wrap"><img src="<%= card.image %>" alt="" class="contribute-card__image" loading="lazy" /></div><% } else if (card.icon) { %><div class="contribute-card__icon-wrap"><i class="fa-solid <%= card.icon %> contribute-card__icon" aria-hidden="true"></i></div><% } %>
          <div class="contribute-card__body">
            <span class="contribute-card__title"><%= card.title %></span>
            <span class="contribute-card__subtitle"><%= card.subtitle %></span>
          </div>
        </a>
      <% } else { %>
        <button type="button" class="contribute-card" data-contribute-action="<%= card.title %>">
          <% if (card.image) { %><div class="contribute-card__image-wrap"><img src="<%= card.image %>" alt="" class="contribute-card__image" loading="lazy" /></div><% } else if (card.icon) { %><div class="contribute-card__icon-wrap"><i class="fa-solid <%= card.icon %> contribute-card__icon" aria-hidden="true"></i></div><% } %>
          <div class="contribute-card__body">
            <span class="contribute-card__title"><%= card.title %></span>
            <span class="contribute-card__subtitle"><%= card.subtitle %></span>
          </div>
        </button>
      <% } %>
    <% }) %>
  </div>

  <section class="landing-metrics">
    <div class="metric-card">
      <span class="metric-value"><%= summary.missions %></span>
      <span class="metric-label"><%= t.metric_missions || 'Missions' %></span>
    </div>
    <div class="metric-card">
      <span class="metric-value"><%= summary.turtles %></span>
      <span class="metric-label"><%= t.metric_turtles || 'Hope Turtles' %></span>
    </div>
    <div class="metric-card">
      <span class="metric-value"><%= summary.successes %></span>
      <span class="metric-label"><%= t.metric_success || 'Successful Landfalls' %></span>
    </div>
  </section>
</main>
<% const pageScripts = [
  'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js',
  '/js/home.js'
]; %>
<%- include('partials/footer', { pageScripts }) %>
