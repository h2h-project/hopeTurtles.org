<%- include('partials/header', { pageTitle, theme }) %>
<%- include('partials/nav') %>
<main id="main" class="layout layout--home">
  <section class="hero">
    <div class="hero-image">
      <img
        src="/images/landing-arrival.webp"
        alt="<%= t.hero_image_alt || 'Illustration of a Hope Turtle floating in the ocean' %>"
        loading="lazy"
      />
    </div>
    <div class="hero-intro">
      <h1><%- t.landing_welcome_title %></h1>
      <p><%- t.landing_intro_paragraph1 %></p>
    </div>
  </section>

  <% const contributeCards = [
    { title: t.contribute_code_title || 'Code', subtitle: t.contribute_code_body || 'Help develop our turtle python code on Github', url: '/turtleos', image: '/images/help-code.webp', subtitleIcon: 'fa-code' },
    { title: t.contribute_build_title || 'Build', subtitle: t.contribute_build_body || 'Generate the carpentry, 3D printing and CNC files to build with your own bottle.', url: '/ecojoiners', image: '/images/ecojoiner-spec-hero.webp', subtitleIcon: 'fa-screwdriver-wrench' },
    { title: t.contribute_bottle_title || 'Bottle', subtitle: t.contribute_bottle_body || 'Send in food filled aid bottles to our coordination hubs', image: '/images/help-food.webp', subtitleIcon: 'fa-bottle-water' },
    { title: t.contribute_commission_title || 'Learn', subtitle: t.contribute_commission_body || 'Learn about our Earthen Humanitarian philosophy', url: '/about', image: '/images/help-realize.webp', subtitleIcon: 'fa-book-open' },
    { title: t.contribute_deploy_title || 'Design', subtitle: t.contribute_deploy_body || 'Get the latest turtle body design source files', image: '/images/help-3d.webp', subtitleIcon: 'fa-cube' },
    { title: t.contribute_buy_title || 'Turtle Shell', subtitle: t.contribute_buy_body || 'Help us develop the printed circuit boards that hold our navigation system.', url: 'https://github.com/h2h-project/turtle_Shells', image: '/images/pcb-card.webp', subtitleIcon: 'fa-hand-holding-heart' }
  ]; %>
  <div class="contribute-grid" id="contribute">
    <% contributeCards.forEach(function (card) { %>
      <% if (card.url) { %>
        <% const isExternal = /^https?:\/\//u.test(card.url); %>
        <a href="<%= card.url %>"<% if (isExternal) { %> target="_blank" rel="noreferrer"<% } %> class="contribute-card">
          <%- include('partials/contribute-card-inner', { card }) %>
        </a>
      <% } else { %>
        <button type="button" class="contribute-card" data-contribute-action="<%= card.title %>">
          <%- include('partials/contribute-card-inner', { card }) %>
        </button>
      <% } %>
    <% }) %>
  </div>

  <section class="contribute-actions">
    <button type="button" class="button ghost" data-contribute-action="Contribute">
      <%= t.landing_contribute_action || 'Contribute Directly' %>
    </button>
    <button type="button" class="button ghost" data-contribute-action="Commission">
      <%= t.landing_commission_action || 'Commission a Turtle' %>
    </button>
  </section>

  <% if (false) { /* landing metrics hidden for now */ %>
  <section class="landing-metrics">
    <div class="metric-card">
      <span class="metric-value"><%= summary.missions %></span>
      <span class="metric-label"><%= t.metric_missions || 'Missions' %></span>
    </div>
    <div class="metric-card">
      <span class="metric-value"><%= summary.turtles %></span>
      <span class="metric-label"><%= t.metric_turtles || 'Hope Turtles' %></span>
    </div>
    <div class="metric-card">
      <span class="metric-value"><%= summary.successes %></span>
      <span class="metric-label"><%= t.metric_success || 'Successful Landfalls' %></span>
    </div>
  </section>
  <% } %>
</main>
<% const pageScripts = ['/js/home.js']; %>
<%- include('partials/footer', { pageScripts }) %>
